# Copy this file to .env and fill in real values. NEVER commit .env.

FLASK_ENV=development

# --- Core secrets ---
SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET_KEY=replace-with-a-different-long-random-string-32-bytes-plus

# --- Database ---
# Local dev can omit this to use SQLite. Production MUST set a Postgres URL:
# postgresql://user:password@host:5432/safevoice
DATABASE_URL=

# --- Mail ---
# Leave blank in local dev: verification/reset links are printed to the
# backend console instead of emailed.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@safevoice.app
REQUIRE_EMAIL_VERIFICATION=false

# --- Payments ---
# Leave both blank to use the built-in test-payment mode (no real gateway call).
# Set both to switch automatically to real Razorpay order creation + verification.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYMENTS_TEST_MODE=true

# --- Sessions ---
SESSION_JOIN_EARLY_MINUTES=10
DEV_ALLOW_EARLY_JOIN=true

# --- Frontend / CORS ---
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- Seed script (optional — random secure values are generated if left blank) ---
ADMIN_EMAIL=admin@safevoice.app
ADMIN_PASSWORD=
SEED_PASSWORD=
